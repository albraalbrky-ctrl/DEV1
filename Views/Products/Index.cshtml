@model IEnumerable<DEV1.Models.Product>

@{
    ViewData["Title"] = "التشكيلة الفاخرة";
}

<style>
    .typography-bg {
        position: relative;
        padding: 30px 0;
        overflow: hidden;
    }
    .giant-text {
        position: absolute;
        top: -10px;
        right: -5%;
        font-size: 6.5rem;
        font-weight: 300;
        color: rgba(220, 167, 98, 0.08); /* رفع التباين قليلاً */
        font-family: 'Georgia', serif;
        font-style: italic;
        pointer-events: none;
        white-space: nowrap;
        user-select: none;
    }
    .hero-sub {
        font-size: 1.1rem;
        color: #cdd7d0; /* تفتيح النص الفرعي ليصبح واضحاً جداً */
        max-width: 600px;
        margin: 0 auto;
    }

    /* الكارت المطور: أقصر، وأكثر وضوحاً */
    .luxury-card {
        background: rgba(20, 26, 23, 0.85); /* تعميق الخلفية الزجاجية لبروز الكلام */
        border: 1px solid rgba(220, 167, 98, 0.25); /* توضيح الحدود */
        border-radius: 20px; /* تقليل الانحناء قليلاً ليتناسق مع الحجم الأصغر */
        overflow: hidden;
        transition: transform 0.4s ease, box-shadow 0.4s ease, border-color 0.4s;
    }
    .luxury-card:hover {
        transform: translateY(-5px);
        border-color: var(--gold-matt);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6);
    }

    .img-container {
        position: relative;
        overflow: hidden;
        background: #0f1311;
    }
    /* تصغير طول الصورة لجعل الكارت قصيراً وأنيقاً */
    .luxury-img {
        height: 200px; 
        object-fit: cover;
        width: 100%;
        transition: transform 0.5s ease;
    }
    .luxury-card:hover .luxury-img {
        transform: scale(1.05);
    }

    .btn-discover {
        background: var(--gold-matt);
        color: #141916 !important;
        font-weight: 700;
        border-radius: 50px;
        padding: 8px 20px;
        font-size: 0.95rem;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-discover:hover {
        background: #fff;
        transform: scale(1.03);
    }

    .price-tag {
        color: #fff; /* جعل السعر أبيض ناصع للوضوح */
        font-family: 'Georgia', serif;
        font-weight: bold;
    }
    .text-gold-highlight {
        color: var(--gold-matt) !important;
    }
</style>

<div class="container text-end mt-4" dir="rtl">
    <div class="typography-bg text-center my-4">
        <div class="giant-text">LOKA STORE</div>
        <h1 class="display-6 fw-bold" style="color: var(--gold-light);">✨ قِطَعْ فَرِيدَة لِتُبْرِزِي جَمَالِكِ ✨</h1>
        <p class="hero-sub mt-2">مجوهرات وإكسسوارات صُممت يدوياً بطابع عصري يحاكي بريقكِ الداخلي النقي.</p>
    </div>

    <div class="row mt-4 g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 luxury-card p-2">
                    <div class="img-container">
                        <img src="@item.ImageUrl" class="luxury-img" alt="@item.Name">
                    </div>
                    <div class="card-body d-flex flex-column p-3 text-center">
                        <h5 class="fw-bold text-white mb-2">@item.Name</h5>
                        <!-- تفتيح لون الوصف ليكون مقروءاً بنسبة 100% -->
                        <p class="text-light-50 fs-6 mb-3 flex-grow-1" style="color: #cbd5e1 !important; min-height: 45px;">@item.Description</p>
                        
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top" style="border-color: rgba(220,167,98,0.15) !important;">
                            <div class="text-start">
                                <span class="fs-4 price-tag text-gold-highlight">@item.Price.ToString("0.00") د.ل</span>
                            </div>
                            
                            @if (item.Stock > 0)
                            {
                                <a asp-controller="Orders" asp-action="Checkout" asp-route-productId="@item.Id" class="btn btn-discover">اقتناء الآن ←</a>
                            }
                            else
                            {
                                <span class="badge bg-danger text-white px-3 py-2 rounded-pill">نفدت</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.luxury-card').forEach(card => {
            card.addEventListener('mousemove', (e) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left - (rect.width/2);
                const y = e.clientY - rect.top - (rect.height/2);
                card.style.transform = `perspective(1000px) rotateX(${-y * 0.02}deg) rotateY(${x * 0.02}deg) translateY(-4px)`;
            });
            card.addEventListener('mouseleave', () => {
                card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0)';
            });
        });
    </script>
}