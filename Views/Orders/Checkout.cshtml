@model DEV1.Models.Order

@{
    ViewData["Title"] = "إتمام الطلب - LOKA STORE";
}

<div class="container mt-5 text-end" dir="rtl">
    <div class="row card shadow p-4 border-0">
        <h2 class="text-center mb-4 text-dark">📋 إتمام طلبك وشراء المنتج</h2>
        <hr />
        
        <div class="row">
            <div class="col-md-5 order-md-2 mb-4">
                <div class="card p-3 bg-light border-0 shadow-sm text-center">
                    <h4 class="text-secondary">تفاصيل القطعة المختارة</h4>
                    <hr>
                    <h5 class="fw-bold text-dark">@Model.Product?.Name</h5>
                    <p class="text-muted">@Model.Product?.Description</p>
                    <span class="badge bg-info text-dark mb-2">المتاح في المخزن: @Model.Product?.Stock قطع</span>
                    
                    <h4 class="text-danger fw-bold mt-2">
                        الإجمالي: <span id="totalPriceDisplay">@Model.Product?.Price.ToString("0.00") د.إ</span>
                    </h4>
                </div>
            </div>

            <div class="col-md-7 order-md-1">
                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold"></div>

                    <input type="hidden" asp-for="ProductId" />

                    <div class="form-group mb-3">
                        <label asp-for="CustomerName" class="form-label fw-bold">الاسم الكامل</label>
                        <input asp-for="CustomerName" class="form-control form-control-lg" placeholder="اكتب اسمك الثلاثي" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold">رقم الهاتف</label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="05xxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Address" class="form-label fw-bold">عنوان التوصيل بالكامل</label>
                        <input asp-for="Address" class="form-control form-control-lg" placeholder="المدينة، اسم الشارع، رقم البناية" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Quantity" class="form-label fw-bold">الكمية المطلوبة</label>
                        <input asp-for="Quantity" class="form-control form-control-lg text-center" type="number" min="1" max="@Model.Product?.Stock" value="1" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 py-3 fw-bold shadow-sm">تأكيد الطلب والشراء الآن 🛍️</button>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-light btn-lg w-100 mt-2">إلغاء والعودة للمتجر</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function() {
            // جلب سعر القطعة الواحدة من الموديل برمجياً
            var unitPrice = parseFloat("@Model.Product?.Price");

            // مراقبة أي تغيير في حقل الكمية
            $('#Quantity').on('input change', function() {
                var qty = parseInt($(this).val());
                
                // التأكد من أن القيمة المدخلة رقمية وصحيحة
                if (isNaN(qty) || qty < 1) {
                    qty = 1;
                }
                
                // عملية الضرب الحسابية التلقائية
                var total = unitPrice * qty;
                
                // تحديث النص المعروض داخل الوسم المخصص له في الأعلى فوراً
                $('#totalPriceDisplay').text(total.toFixed(2) + " د.إ");
            });
        });
    </script>
}
}