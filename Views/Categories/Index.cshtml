@model IEnumerable<DEV1.Models.Category>

@{
    ViewData["Title"] = "الأقسام";
}

<style>
    .category-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(220, 167, 98, 0.3);
        border-radius: 20px;
        border-left: 5px solid var(--gold-matt);
        transition: all 0.3s ease;
        text-decoration: none !important;
    }
    .category-box:hover {
        background: var(--gold-matt);
        transform: scale(1.02);
    }
    /* جعل النصوص داخل الصندوق تتحول للأسود عند الهوفر لتظل مقروءة */
    .category-box:hover h4, .category-box:hover span {
        color: #141916 !important;
    }
    .text-bright-white {
        color: #ffffff !important;
    }
    .text-bright-gold {
        color: #fcd34d !important;
    }
</style>

<div class="container mt-5 text-end" dir="rtl">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-bright-white">🗂️ تصنيفات LOKA STORE</h2>
        <p class="fs-5 text-bright-gold">تسوقي حسب القسم الذي يروق لكِ</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            @foreach (var item in Model)
            {
                <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@item.Id" 
                   class="category-box d-flex justify-content-between align-items-center p-4 mb-3 shadow-sm">
                    <h4 class="m-0 fw-bold text-bright-white">💎 @item.Name</h4>
                    <span class="fw-bold text-bright-gold">استكشاف التشكيلة ←</span>
                </a>
            }
            <div class="text-center mt-5">
                <a asp-controller="Products" asp-action="Index" class="btn btn-discover btn-lg px-5">مشاهدة كافة المعروضات</a>
            </div>
        </div>
    </div>
</div>