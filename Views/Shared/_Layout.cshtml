<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LOKA STORE</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-deep: #141916; /* الأخضر الزيتوني العميق جداً من الصورة */
            --gold-matt: #dca762; /* الذهبي المطفي الدافئ */
            --gold-light: #f5eedc;
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(220, 167, 98, 0.15);
        }

        /* تخصيص السكرول بار الاحترافي */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-deep);
        }
        ::-webkit-scrollbar-thumb {
            background: var(--gold-matt);
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #c59353;
        }

        body {
            font-family: 'Cairo', sans-serif;
            background-color: var(--bg-deep);
            color: #e0e0e0;
            overflow-x: hidden;
            position: relative;
        }

        /* زخارف متموجة انسيابية في الخلفية تحاكي الصورة */
        body::before {
            content: "";
            position: fixed;
            top: -10%;
            left: -10%;
            width: 60vw;
            height: 60vh;
            background: radial-gradient(circle, rgba(220, 167, 98, 0.05) 0%, transparent 70%);
            pointer-events: none;
            z-index: -1;
        }

        body::after {
            content: "";
            position: fixed;
            bottom: -5%;
            right: -5%;
            width: 50vw;
            height: 50vh;
            background: radial-gradient(circle, rgba(220, 167, 98, 0.03) 0%, transparent 60%);
            pointer-events: none;
            z-index: -1;
        }

        /* نافبار زجاجي فاخر معلق */
        .navbar {
            background: rgba(20, 25, 22, 0.8) !important;
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            padding: 15px 0;
            sticky-top: top;
        }
        .navbar-brand {
            font-weight: 700;
            color: var(--gold-matt) !important;
            letter-spacing: 2px;
            text-shadow: 0 0 10px rgba(220, 167, 98, 0.2);
        }
        .nav-link {
            color: #b5beb8 !important;
            font-size: 1.05rem;
            margin: 0 10px;
            position: relative;
            transition: color 0.4s ease;
        }
        .nav-link:hover {
            color: var(--gold-matt) !important;
        }
        .nav-link::after {
            content: "";
            position: absolute;
            bottom: -5px;
            left: 50%;
            width: 0;
            height: 1px;
            background: var(--gold-matt);
            transition: all 0.4s ease;
            transform: translateX(-50%);
        }
        .nav-link:hover::after {
            width: 80%;
        }

        footer {
            background: #0f1210;
            border-top: 1px solid var(--glass-border);
            color: #7b8880;
        }

        /* حركات الظهور الانسيابية للصفحات (Page Transitions) */
        .animate-fade-in {
            animation: fadeInPage 1s cubic-bezier(0.25, 1, 0.5, 1) forwards;
        }
        @@keyframes fadeInPage {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg fixed-top" dir="rtl">
            <div class="container">
                <a class="navbar-brand fs-3 font-monospace" asp-controller="Products" asp-action="Index">👑 LOKA STORE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" style="border-color: var(--glass-border);">
                    <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav pe-0 text-center">
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Products" asp-action="Index">المتجر الرئيسي </a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Categories" asp-action="Index">الأقسام</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="TrackOrder">🔍 تتبع طلبك</a></li>
                        <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Home" asp-action="ContactUs">📞 اتصلي بنا</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    
    <!-- مسافة أمان لكي لا تختفي المحتويات تحت النافبار المعلق -->
    <div class="container" style="margin-top: 120px;">
        <main role="main" class="pb-5 animate-fade-in">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4 mt-5 text-center" dir="rtl">
        <div class="container">
            <p class="m-0 text-white-50">جميع الحقوق محفوظة &copy; 2026 - <span style="color: var(--gold-matt); font-weight: bold;">LOKA STORE</span></p>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>